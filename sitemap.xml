<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap INDEX — points crawlers at two sitemaps instead of one:
    1. sitemap-pages.xml     — the 30 fixed marketing/content pages
                                (was the entire /sitemap.xml before).
    2. sitemap-packages.xml  — individual package & blog post URLs,
                                generated live from the database by
                                the generate-sitemap edge function
                                (see supabase/functions/generate-sitemap).

  This file (sitemap.xml) is what robots.txt points at and what gets
  submitted to Google Search Console — submit this one, not the two
  files it references individually.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://www.zoomfly.in/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://www.zoomfly.in/sitemap-packages.xml</loc>
  </sitemap>
</sitemapindex>
